# Copy this file to .env and fill in the values. Never commit .env.

# 1 = local test mode (codes shown on screen, test inbox). Must be 0 on a live site.
MTB_DEV_MODE=1
# Long random secret (48+ characters). Signs sessions and seals the audit log. Keep it private and never change it on a live site.
MTB_SECRET=
# Optional: Google Maps key for address autofill (restrict it to your site's address).
MTB_GOOGLE_MAPS_KEY=
# MTB Admins (comma-separated). Create their login with: python create_admin.py email "First Last"
MTB_ADMIN_EMAILS=

# Email through Brevo (free plan: 300 emails a day). Use EITHER the API key OR the SMTP login + key.
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Sender (must be verified in Brevo) and the public address of the site used in email links.
MTB_MAIL_FROM=
MTB_MAIL_FROM_NAME=My Trial Board
MTB_APP_URL=http://127.0.0.1:8000

# SMS is not connected yet: show the sign-up phone code on the person's own screen. Set to 0 once SMS works.
MTB_PHONE_CODE_ON_SCREEN=1
# Optional: sign-in length in hours (default 8) and forcing https (default on when MTB_DEV_MODE=0).
# MTB_SESSION_HOURS=8
# MTB_FORCE_HTTPS=1

# My Profile: reading uploaded CVs with OpenAI. Without a key, CV auto-fill is switched off (everything else still works).
OPENAI_API_KEY=
# Optional: model used to read CVs (default gpt-6.1-terra) and reasoning effort (e.g. low). Leave empty for defaults.
# MTB_OPENAI_MODEL=
# MTB_OPENAI_REASONING=
